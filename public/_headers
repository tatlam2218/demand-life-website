# Always re-fetch index.html so users never see a stale shell that points to old JS/CSS hashes.
# The hashed assets below CAN be cached for a year (Vite gives them a content-hash filename
# that changes on every release, so cache-busting is automatic).
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Hashed JS/CSS bundles — safe to cache aggressively (filename changes on every deploy)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images that aren't fingerprinted — moderate cache, can be force-refreshed
/hero/*
  Cache-Control: public, max-age=86400
/hero-hd/*
  Cache-Control: public, max-age=86400
/hero-opt/*
  Cache-Control: public, max-age=86400
/rooms/*
  Cache-Control: public, max-age=86400
/rooms-opt/*
  Cache-Control: public, max-age=86400
/payment/*
  Cache-Control: public, max-age=86400
